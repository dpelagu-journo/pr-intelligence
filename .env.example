# Copia este fichero como .env y rellena los valores

# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Ruta donde se guardan los vectores (relativa al directorio backend/)
VECTOR_STORE_PATH=../data/vector_store

# Directorio donde se guardan los ficheros subidos
UPLOAD_DIR=../uploads
